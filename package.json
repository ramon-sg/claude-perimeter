{
  "name": "@ramon-sg/claude-perimeter",
  "version": "0.3.1",
  "description": "Barandas para Claude Code: sandbox del sistema operativo, Safety Net, reglas de git y un doctor que muestra qué falta.",
  "type": "module",
  "bin": {
    "claude-perimeter": "bin/claude-perimeter.mjs"
  },
  "files": [
    "bin",
    "src",
    "hooks/*.sh",
    "!hooks/*.test.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test 'test/*.test.mjs' && bash hooks/guard-git.test.sh && bash hooks/log-permission-request.test.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramon-sg/claude-perimeter.git"
  },
  "keywords": [
    "claude-code",
    "sandbox",
    "security",
    "git",
    "kubernetes"
  ],
  "license": "MIT",
  "dependencies": {
    "cc-safety-net": "2.6.18"
  }
}
